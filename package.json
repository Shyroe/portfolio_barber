{
  "name": "portfolio_barber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/build/serve-static.mjs --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm run build && playwright test --workers=1",
    "test:e2e:cross": "pnpm run build && PLAYWRIGHT_BROWSERS=cross playwright test --workers=1",
    "audit:a11y": "pnpm run build && playwright test e2e/accessibility.spec.ts --workers=1",
    "assets:derivatives": "node scripts/build/generate-image-derivatives.mjs",
    "assets:derivatives:check": "node scripts/build/generate-image-derivatives.mjs --check",
    "validate": "pnpm run typecheck && pnpm run test:run && pnpm run check:biome && pnpm run build",
    "cf:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "deploy": "pnpm run validate && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.136.0"
  },
  "description": "Landing page do curso Gentleman Barber — desafio técnico frontend de alta fidelidade visual com Next.js (App Router), React 19, TypeScript, Tailwind CSS v4, shadcn/ui e Cloudflare Workers.",
  "license": "MIT",
  "homepage": "https://barber.leonardocamargo.dev.br/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shyroe/portfolio_barber.git"
  },
  "bugs": {
    "url": "https://github.com/Shyroe/portfolio_barber/issues"
  }
}
